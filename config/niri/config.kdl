// niri configuration (KDL) - installed to ~/.config/niri/config.kdl by niriInstall.sh
// Wiki: https://niri-wm.github.io/niri/Configuration:-Introduction
// Reload happens automatically when ~/.config/niri/config.kdl is saved.
// Press Mod+Shift+Slash inside niri to see the hotkey overlay.

// ---------------------------------------------------------------------------
// Input
// ---------------------------------------------------------------------------
input {
    keyboard {
        xkb {
            // layout "us"
            // options "compose:ralt,ctrl:nocaps"
        }

        // Snappier key repeat delay and rate.
        repeat-delay 200
        repeat-rate 35
        numlock
    }

    // Touchpad settings (adjust to personal preference).
    touchpad {
        // off
        tap
        // dwt
        // dwtp
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
        // scroll-method "two-finger"
        // disabled-on-external-mouse
    }

    mouse {
        // natural-scroll
        // accel-speed 0.2
        // accel-profile "flat"
    }

    // Focus follows mouse (restricted to windows already fully visible on screen).
    focus-follows-mouse max-scroll-amount="0%"
}

// ---------------------------------------------------------------------------
// Outputs
// ---------------------------------------------------------------------------
// Run `niri msg outputs` to query connected display connectors and supported modes.

// Built-in display
output "eDP-1" {
    mode "3840x2400@60.000"
    scale 2.5
    transform "normal"
    position x=0 y=0
}

// ---------------------------------------------------------------------------
// Layout
// ---------------------------------------------------------------------------
layout {
    gaps 5
    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 1.5
        active-color "#7fc8ff"
        inactive-color "#505050"
    }

    border {
        off
    }

    shadow {
        // Uncomment 'on' to enable window shadows.
        // on
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }

    struts {
        // left 64
        // right 64
        // top 64
        // bottom 64
    }
}

// ---------------------------------------------------------------------------
// Autostart
// ---------------------------------------------------------------------------
// Noctalia provides the status bar, launcher, notifications, lock screen, wallpaper, and OSD.
spawn-at-startup "noctalia"

// xwayland-satellite is started automatically by niri when installed.
// Manual swaybg fallback if you do not want Noctalia to manage wallpapers:
// spawn-sh-at-startup "swaybg -i ~/Pictures/Wallpapers/wall.png -m fill"

// ---------------------------------------------------------------------------
// General & Environment
// ---------------------------------------------------------------------------
hotkey-overlay {
    // Uncomment this line to disable the "Important Hotkeys" pop-up at startup.
    // skip-at-startup
}

// Request applications to omit client-side decorations (CSD) and let niri manage borders.
prefer-no-csd

// Screenshot save location and naming format.
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// Animation settings (omit to use default animations).
animations {
    // off
    // slowdown 3.0
}

// Allow Noctalia notification actions and window activation without matching serials.
debug {
    honor-xdg-activation-with-invalid-serial
}

// ---------------------------------------------------------------------------
// Window & Layer Rules
// ---------------------------------------------------------------------------
// Default window rules: square corners, clip to geometry, and open windows maximized.
window-rule {
    geometry-corner-radius 0
    clip-to-geometry true
    open-maximized true
}

// Noctalia settings window opens floating with preset dimensions.
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

// Helium (Chromium-based) picture-in-picture window floats.
window-rule {
    match app-id=r#"^helium"# title="^Picture in picture$"
    open-floating true
}

// Noctalia: blurred/tinted wallpaper copy shown behind the Overview.
// Requires [backdrop] enabled = true in ~/.config/noctalia/config.toml.
layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}

// ---------------------------------------------------------------------------
// Keybinds (Mod = Super)
// ---------------------------------------------------------------------------
binds {
    // Cheatsheet overlay
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Applications
    Mod+Return hotkey-overlay-title="Open a Terminal: alacritty" { spawn "alacritty"; }

    // Noctalia desktop shell integration
    Mod+Space   hotkey-overlay-title="Noctalia Launcher"       { spawn-sh "noctalia msg panel-toggle launcher"; }
    Mod+N       hotkey-overlay-title="Noctalia Control Center" { spawn-sh "noctalia msg panel-toggle control-center"; }
    Super+Alt+L hotkey-overlay-title="Lock the Screen"         { spawn-sh "noctalia msg session lock"; }
    Alt+Tab     hotkey-overlay-title="Window Switcher"         { spawn-sh "noctalia msg window-switcher"; }

    // Volume & display brightness via Noctalia (displays OSD)
    XF86AudioRaiseVolume  allow-when-locked=true { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute         allow-when-locked=true { spawn-sh "noctalia msg volume-mute"; }
    XF86AudioMicMute      allow-when-locked=true { spawn-sh "noctalia msg mic-mute"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }

    // Media playback controls
    XF86AudioPlay  allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn-sh "playerctl play-pause"; }
    XF86AudioStop  allow-when-locked=true { spawn-sh "playerctl stop"; }
    XF86AudioPrev  allow-when-locked=true { spawn-sh "playerctl previous"; }
    XF86AudioNext  allow-when-locked=true { spawn-sh "playerctl next"; }

    // Window & overview management
    Mod+O repeat=false { toggle-overview; }
    Mod+Q repeat=false { close-window; }

    // Focus navigation (arrow keys & column ends)
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+Home  { focus-column-first; }
    Mod+End   { focus-column-last; }

    // Window & column movement
    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Home  { move-column-to-first; }
    Mod+Ctrl+End   { move-column-to-last; }

    // Multi-monitor navigation
    Mod+Shift+Left  { focus-monitor-left; }
    Mod+Shift+Down  { focus-monitor-down; }
    Mod+Shift+Up    { focus-monitor-up; }
    Mod+Shift+Right { focus-monitor-right; }

    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }

    // Vertical workspace navigation
    Mod+Page_Down       { focus-workspace-down; }
    Mod+Page_Up         { focus-workspace-up; }
    Mod+Ctrl+Page_Down  { move-column-to-workspace-down; }
    Mod+Ctrl+Page_Up    { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-workspace-down; }
    Mod+Shift+Page_Up   { move-workspace-up; }

    // Mouse wheel workspace & column navigation
    Mod+WheelScrollDown      cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp        cooldown-ms=150 { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Ctrl+WheelScrollRight { move-column-right; }
    Mod+Ctrl+WheelScrollLeft  { move-column-left; }

    Mod+Shift+WheelScrollDown      { focus-column-right; }
    Mod+Shift+WheelScrollUp        { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // Workspaces (direct numeric navigation 1-9)
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // Focus previous workspace:
    // Mod+Tab { focus-workspace-previous; }

    // Column & window grouping
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma        { consume-window-into-column; }
    Mod+Period       { expel-window-from-column; }

    // Size presets & resets
    Mod+R            { switch-preset-column-width; }
    Mod+Shift+R      { switch-preset-column-width-back; }
    Mod+Ctrl+Shift+R { switch-preset-window-height; }
    Mod+Ctrl+R       { reset-window-height; }

    // Window sizing & positioning
    Mod+F            { maximize-column; }
    Mod+Shift+F      { fullscreen-window; }
    Mod+M            { maximize-window-to-edges; }
    Mod+Ctrl+F       { expand-column-to-available-width; }

    // Column alignment
    Mod+Shift+C      { center-column; }
    Mod+Ctrl+C       { center-visible-columns; }

    // Fine dimension adjustments
    Mod+Minus        { set-column-width "-10%"; }
    Mod+Equal        { set-column-width "+10%"; }
    Mod+Shift+Minus  { set-window-height "-10%"; }
    Mod+Shift+Equal  { set-window-height "+10%"; }

    // Floating & layout modes
    Mod+Alt+V        { toggle-window-floating; }
    Mod+Shift+V      { switch-focus-between-floating-and-tiling; }
    Mod+W            { toggle-column-tabbed-display; }

    // Screenshots
    Print      { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }

    // Keyboard shortcuts inhibitor
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // Session management
    Mod+Shift+E     { quit; }
    Ctrl+Alt+Delete { quit; }
    Mod+Shift+P     { power-off-monitors; }
}
